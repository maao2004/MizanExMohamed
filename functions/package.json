{
  "name": "mizan-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Mizan EGX Valuation & Audit Platform",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^5.7.2"
  },
  "private": true
}
